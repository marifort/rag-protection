#!/usr/bin/env bash
# Convenience wrapper for the mcp-lint MCP manifest linter.
#
# Runs `python -m mcp_lint` from any directory by putting tools/ on PYTHONPATH
# and preferring the repo virtualenv.
#
# Examples:
#   tools/mcp-lint scan --manifest tools/mcp_lint/examples/good_tools.json
#   tools/mcp-lint scan --url http://localhost:8000/mcp
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [[ -x "${REPO_ROOT}/.venv/bin/python" ]]; then
  PY="${REPO_ROOT}/.venv/bin/python"
else
  PY="$(command -v python3 || command -v python)"
fi

PYTHONPATH="${SCRIPT_DIR}${PYTHONPATH:+:${PYTHONPATH}}" exec "${PY}" -m mcp_lint "$@"
