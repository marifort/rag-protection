#!/usr/bin/env bash
# Convenience wrapper for the rag-injbench injection benchmark.
#
# Runs `python -m inj_bench` from any directory by putting tools/ on PYTHONPATH
# and preferring the repo virtualenv.
#
# Examples (run from repo root):
#   tools/rag-injbench run --target builtin
#   tools/rag-injbench run --published-only --format junit --output injbench.xml
#   tools/rag-injbench run --target http://localhost:8080/v1/scan --header "X-Admin-Key: secret"
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [[ -x "${REPO_ROOT}/.venv/bin/python" ]]; then
  PY="${REPO_ROOT}/.venv/bin/python"
else
  PY="$(command -v python3 || command -v python)"
fi

export RAG_EMBEDDING_BACKEND="${RAG_EMBEDDING_BACKEND:-hash}"
PYTHONPATH="${SCRIPT_DIR}${PYTHONPATH:+:${PYTHONPATH}}" exec "${PY}" -m inj_bench "$@"
