#!/usr/bin/env bash
# Convenience wrapper for the rag-score posture scorecard.
#
# Runs `python -m rag_score` from any directory by putting tools/ on PYTHONPATH
# and preferring the repo virtualenv. The CLI's default --policy/--acl/--sample-docs
# paths are absolute (resolved from the repo root), so it works regardless of the
# current working directory.
#
# Examples:
#   tools/rag-score                                   # grade shipped config (prod), markdown
#   tools/rag-score --acl rag-protection-proxy/config/acl_policy.prod.yaml
#   tools/rag-score --format html --output posture.html
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [[ -x "${REPO_ROOT}/.venv/bin/python" ]]; then
  PY="${REPO_ROOT}/.venv/bin/python"
else
  PY="$(command -v python3 || command -v python)"
fi

PYTHONPATH="${SCRIPT_DIR}${PYTHONPATH:+:${PYTHONPATH}}" exec "${PY}" -m rag_score "$@"
