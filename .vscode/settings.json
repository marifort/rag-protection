{
  "typescript.tsdk": "console/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "markdown.mermaid.enabled": true,
  "python.terminal.useEnvFile": true,
  "python.terminal.activateEnvironment": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "terminal.integrated.defaultProfile.osx": "zsh (.venv)",
  "terminal.integrated.profiles.osx": {
    "zsh": {
      "path": "zsh"
    },
    "zsh (.venv)": {
      "path": "zsh",
      "args": [
        "-c",
        "[ -f .venv/bin/activate ] && . .venv/bin/activate; exec zsh"
      ]
    }
  },
  "isort.importStrategy": "useBundled",
  "isort.interpreter": [
    "${workspaceFolder}/.venv/bin/python"
  ],
  "python.analysis.extraPaths": [
    "${workspaceFolder}/examples"
  ],
  "markdown.preview.openMarkdownLinks": "inEditor"
}
