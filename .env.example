# RAG Protection Proxy — environment variables

# Service
RAG_PORT=8090
RAG_LOG_LEVEL=INFO
RAG_ADMIN_API_KEY=rag-admin-demo-key

# EE entitlements (comma-separated). docker_start.sh sources this file and
# overwrites a prior shell `export RAG_EE_ENTITLEMENTS=...` — put keys here, then recreate.
# Full demo: dlp:hipaa,dlp:pci,dlp:gdpr,egress:denylist,egress:healthcare,egress:fintech,egress:saas,egress:public_sector,baseline:healthcare,baseline:fintech,baseline:saas,baseline:public_sector,weekly_digest,evidence_pack,tool_registry,inj_corpus:full
# Dev shortcut: all  or  *
# Missing weekly_digest → GET /admin/digest/preview returns 404 (route not registered).
# RAG_EE_ENTITLEMENTS=

# Docker Model Runner (Compose injects RAG_LLM_BASE_URL via models binding)
MODEL_RUNNER_MODEL=ai/gemma3-qat
RAG_LLM_MODEL=ai/gemma3-qat
RAG_LLM_API_KEY=not-needed
# compose.yml requires Docker Desktop Model Runner. Without it, start:
#   docker compose -f compose.ci.yml up -d --build --wait
# and set an OpenAI-compatible URL. localhost inside that container is the
# proxy — use host.docker.internal for an LLM on the host.
# RAG_LLM_BASE_URL=http://host.docker.internal:11434/v1
# RAG_LLM_MODEL=llama3

# Optional JWT auth (leave empty to use demo bearer tokens only)
RAG_JWT_SECRET=

# Data persistence (Compose bind-mounts ./data → /data in the container)
RAG_DATA_DIR=./data
RAG_AUDIT_FILE=./data/audit.jsonl
# Weekly digest (#26) file send: compose.yml pins RAG_DIGEST_OUTPUT_DIR=/data/digest
# (host ./data/digest). Do not export RAG_DIGEST_OUTPUT_DIR=/tmp/rag-digest — that
# path is inside the container, not the host bind mount.

# Optional SCIM group sync (E2.1)
# RAG_SCIM_ENABLED=true
# RAG_SCIM_FIXTURE_FILE=./tests/fixtures/scim_groups.json
# RAG_SCIM_BASE_URL=https://scim.example.com/v2
# RAG_SCIM_BEARER_TOKEN=

# Optional connector scheduler (E5.7)
# RAG_CONNECTORS_ENABLED=true
# RAG_CONNECTOR_SCHEDULE_FILE=config/connectors/schedule.yaml

# Optional Google Drive OAuth (E5.6 — live connector ingest)
# RAG_GOOGLE_CLIENT_ID=
# RAG_GOOGLE_CLIENT_SECRET=
# RAG_GOOGLE_REDIRECT_URI=http://localhost:8090/admin/connectors/google-drive/oauth/callback

# RAG_AUDIT_WEBHOOK_URL=https://hooks.example.com/audit
# RAG_AUDIT_WEBHOOK_TIMEOUT=5
# RAG_AUDIT_WEBHOOK_HEADERS={"Authorization":"Bearer your-token"}

# Store backend (proxy corpus — Documents UI / /v1/query / /v1/ingest)
# sqlite  = default; no Qdrant container
# vector  = Qdrant semantic store (auto-enables compose profile qdrant / --qdrant)
# hybrid  = SQLite + Qdrant RRF (also auto-enables --qdrant)
#
# IMPORTANT: RAG_STORE_BACKEND=vector|hybrid starts Qdrant on ANY
#   bash tools/docker_start.sh
# even with neither --qdrant nor --pinecone. --pinecone does not cancel this.
# Use sqlite (below) when you want Pinecone Local / Pattern C without Qdrant.
# RAG_STORE_BACKEND=sqlite
# RAG_QDRANT_URL=http://qdrant:6333
# RAG_QDRANT_COLLECTION=rag_chunks
# RAG_QDRANT_PORT=6333

# Optional Pinecone Local (compose profile pinecone / docker_start.sh --pinecone)
# Pattern C examples only — not a CE retrieval backend. Prefer RAG_STORE_BACKEND=sqlite
# when using --pinecone so Qdrant is not auto-started.
# Switch stacks: docs/commercial/COMPOSE_OVERLAYS.md#switching-qdrant-and-pinecone-local
# RAG_PINECONE_PORT=5081
# PINECONE_DIMENSION=8
# PINECONE_INDEX_HOST=http://localhost:5081
# PINECONE_API_KEY=pclocal
# PINECONE_NAMESPACE=pattern-c-demo
